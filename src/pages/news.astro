---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import Footer from '../components/Footer.astro';
import { getNewsArticles } from '../utils/articles';

const newsArticles = await getNewsArticles();
---

<Layout title="News & Updates — VoxelWire" description="The latest gaming news, hardware architecture breakdowns, patch notes, and guides.">
  <Header activeCategory="News" />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <!-- Page Header -->
    <div class="mb-10 pb-6 border-b border-slate-800 flex items-center justify-between flex-wrap gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-3 h-3 rounded-full bg-[#A855F7] shadow-[0_0_12px_#A855F7]"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-[#A855F7]">Live Feed</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white font-heading">
          All News & Content Wire
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Everything happening across gaming and technology—hardware announcements, patch breakdowns, and game guides.
        </p>
      </div>

      <div class="text-xs font-mono text-slate-400 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-lg">
        {newsArticles.length} Stories Loaded
      </div>
    </div>

    <!-- Article Grid -->
    <ArticleGrid articles={newsArticles} title="Latest News & Briefs" />
  </main>

  <Footer />
</Layout>
