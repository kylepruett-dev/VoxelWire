---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Cookie Settings & Policy — VoxelWire" 
  description="Manage your cookie preferences and learn about how VoxelWire uses cookies to optimize your browsing experience."
>
  <Header />

  <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <header class="mb-10 pb-6 border-b border-slate-800">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-950/70 text-[#C084FC] border border-[#A855F7]/40 text-xs font-mono font-semibold uppercase tracking-widest mb-3">
        Privacy Controls
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white font-heading">
        Cookie Settings & Policy
      </h1>
      <p class="text-slate-400 text-sm mt-2 font-mono">Customize your privacy preferences below</p>
    </header>

    <!-- Interactive Preference Manager Card -->
    <div class="bg-slate-900/60 rounded-3xl border border-slate-800 p-6 sm:p-8 mb-12 space-y-6">
      <div class="pb-4 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-white font-heading">Manage Cookie Preferences</h2>
          <p class="text-xs text-slate-400 mt-1">Control which cookies VoxelWire uses during your visit.</p>
        </div>
        <span class="text-xs font-mono bg-purple-950 text-[#C084FC] border border-[#A855F7]/30 px-3 py-1 rounded-full hidden sm:inline-block">
          Privacy Mode: Active
        </span>
      </div>

      <div class="space-y-4">
        <!-- Essential Cookies (Always Active) -->
        <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80 flex items-start justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-white">Essential Cookies</span>
              <span class="text-[10px] font-mono uppercase bg-slate-800 text-slate-300 px-2 py-0.5 rounded">Required</span>
            </div>
            <p class="text-xs text-slate-400">
              Necessary for basic site navigation, security sessions, and font caching. Cannot be disabled.
            </p>
          </div>
          <div class="shrink-0 pt-1">
            <span class="text-xs font-mono text-[#A855F7] font-semibold bg-[#A855F7]/10 px-2.5 py-1 rounded-md border border-[#A855F7]/30">Always On</span>
          </div>
        </div>

        <!-- Performance & Analytics -->
        <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80 flex items-start justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-white">Analytics & Performance</span>
              <span class="text-[10px] font-mono uppercase bg-purple-950 text-[#C084FC] px-2 py-0.5 rounded">Optional</span>
            </div>
            <p class="text-xs text-slate-400">
              Helps us measure article popularity and optimize page load speeds across devices.
            </p>
          </div>
          <div class="shrink-0 pt-1">
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="analytics-toggle" checked class="sr-only peer">
              <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#A855F7]"></div>
            </label>
          </div>
        </div>

        <!-- Personalization -->
        <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80 flex items-start justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-white">Personalization</span>
              <span class="text-[10px] font-mono uppercase bg-purple-950 text-[#C084FC] px-2 py-0.5 rounded">Optional</span>
            </div>
            <p class="text-xs text-slate-400">
              Remembers your preferred topic filters and layout settings across sessions.
            </p>
          </div>
          <div class="shrink-0 pt-1">
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="personalization-toggle" checked class="sr-only peer">
              <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#A855F7]"></div>
            </label>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
        <button
          id="save-cookies-btn"
          class="bg-[#A855F7] hover:bg-[#9333EA] text-white text-xs uppercase tracking-wider font-bold py-2.5 px-6 rounded-full transition-all duration-200 shadow-[0_0_15px_rgba(168,85,247,0.3)] hover:scale-105"
        >
          Save Preferences
        </button>
        <span id="save-status" class="text-xs font-mono text-emerald-400 hidden">
          ✓ Preferences saved
        </span>
      </div>
    </div>

    <!-- Informational Article -->
    <article class="prose prose-invert prose-purple max-w-none space-y-6 text-slate-300 text-sm sm:text-base leading-relaxed">
      <section class="space-y-3 bg-slate-900/40 p-6 rounded-2xl border border-slate-800">
        <h2 class="text-xl font-bold text-white font-heading">What Are Cookies?</h2>
        <p>
          Cookies are small text files stored on your device when you visit websites. They allow sites to remember user preferences, maintain secure sessions, and collect anonymous traffic data.
        </p>
      </section>

      <section class="space-y-3 bg-slate-900/40 p-6 rounded-2xl border border-slate-800">
        <h2 class="text-xl font-bold text-white font-heading">Browser Control</h2>
        <p>
          In addition to our preference panel above, you can configure your browser settings to reject or clear cookies at any time. Refer to your browser's help documentation for instructions on managing stored cookies.
        </p>
      </section>
    </article>
  </main>

  <Footer />
</Layout>

<script>
  const saveBtn = document.getElementById('save-cookies-btn');
  const statusText = document.getElementById('save-status');

  saveBtn?.addEventListener('click', () => {
    if (statusText) {
      statusText.classList.remove('hidden');
      setTimeout(() => {
        statusText.classList.add('hidden');
      }, 3000);
    }
  });
</script>
