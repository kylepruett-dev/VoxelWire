---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import Footer from '../components/Footer.astro';
import { getArticlesData } from '../utils/articles';

const { featured, latest, all } = await getArticlesData();
---

<Layout title="VoxelWire — Gaming & Tech News | High-Contrast Wire Briefs">
  <Header activeCategory="All" />

  <main class="flex-1">
    <!-- Auto-Updating Featured Hero Section -->
    {featured && <HeroSection featured={featured} latest={latest} />}

    <!-- Interactive Category Filter Tabs & Article Grid -->
    <ArticleGrid articles={all} title="Trending & Latest Stories" />
  </main>

  <Footer />
</Layout>
