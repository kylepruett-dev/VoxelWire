---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import Footer from '../components/Footer.astro';
import { getArticlesData } from '../utils/articles';

const { all: allArticles } = await getArticlesData();
---

<Layout title="Search Articles — VoxelWire" description="Search articles, news, and reviews on VoxelWire.">
  <Header />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <div class="mb-10 pb-6 border-b border-slate-800">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-3 h-3 rounded-full bg-[#A855F7] shadow-[0_0_12px_#A855F7]"></span>
        <span class="text-xs font-mono uppercase tracking-widest text-[#A855F7]">Live Search Index</span>
      </div>
      <h1 id="search-page-title" class="text-3xl sm:text-4xl font-extrabold text-white font-heading">
        Search Results
      </h1>
      <p id="search-page-subtitle" class="text-slate-400 text-sm mt-1">
        Searching across all published articles, news briefs, and editorial reviews.
      </p>
    </div>

    <div id="search-results-wrapper">
      <ArticleGrid articles={allArticles} title="Matching Stories" />
    </div>

    <!-- Empty State Container -->
    <div id="no-search-results" class="hidden text-center py-16 bg-slate-900/40 rounded-3xl border border-slate-800 my-8">
      <div class="w-16 h-16 rounded-2xl bg-purple-950/80 border border-[#A855F7]/40 flex items-center justify-center text-[#A855F7] mx-auto mb-4 shadow-[0_0_20px_rgba(168,85,247,0.25)]">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white font-heading mb-2">No Matching Articles Found</h3>
      <p id="no-results-subtext" class="text-slate-400 text-sm max-w-md mx-auto mb-6">
        We couldn't find any articles matching your search query. Try checking for typos or searching for a different keyword.
      </p>
      <a href="/" class="inline-flex items-center gap-2 bg-[#A855F7] hover:bg-[#9333EA] text-white text-xs font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all shadow-[0_0_15px_rgba(168,85,247,0.3)]">
        Back to Home Page
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function performSearch() {
    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get('q')?.trim() || '';
    const titleEl = document.getElementById('search-page-title');
    const subtitleEl = document.getElementById('search-page-subtitle');
    const items = document.querySelectorAll('.article-item');
    const noResultsEl = document.getElementById('no-search-results');
    const noResultsSubtext = document.getElementById('no-results-subtext');

    if (!query) {
      if (titleEl) titleEl.textContent = "All Articles";
      if (subtitleEl) subtitleEl.textContent = "Browse all published articles and editorial reviews.";
      return;
    }

    if (titleEl) titleEl.textContent = `Search Results for "${query}"`;
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    let visibleCount = 0;

    items.forEach((item) => {
      const title = (item.getAttribute('data-title') || '').toLowerCase();
      const excerpt = (item.getAttribute('data-excerpt') || '').toLowerCase();
      const category = (item.getAttribute('data-category') || '').toLowerCase();
      const tags = (item.getAttribute('data-tags') || '').toLowerCase();

      // Check if EVERY search term matches title, excerpt, category, or tags
      const isMatch = terms.every(term => 
        title.includes(term) || 
        excerpt.includes(term) || 
        category.includes(term) || 
        tags.includes(term)
      );

      if (isMatch) {
        (item as HTMLElement).style.display = 'block';
        visibleCount++;
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });

    if (subtitleEl) {
      subtitleEl.textContent = `Found ${visibleCount} ${visibleCount === 1 ? 'story' : 'stories'} matching "${query}".`;
    }

    if (visibleCount === 0 && noResultsEl) {
      noResultsEl.classList.remove('hidden');
      if (noResultsSubtext) {
        noResultsSubtext.textContent = `We couldn't find any articles matching "${query}". Try searching for terms like "GTA", "Stalker", "Vice City", or "Review".`;
      }
    } else if (noResultsEl) {
      noResultsEl.classList.add('hidden');
    }
  }

  // Run search on page load
  performSearch();
</script>
