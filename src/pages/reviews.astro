---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import Footer from '../components/Footer.astro';
import { getReviewArticles } from '../utils/articles';

const reviewArticles = await getReviewArticles();
---

<Layout title="Reviews — VoxelWire" description="In-depth, uncompromised reviews and score breakdowns for the biggest games and hardware.">
  <Header activeCategory="Reviews" />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <!-- Page Header -->
    <div class="mb-10 pb-6 border-b border-slate-800 flex items-center justify-between flex-wrap gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-3 h-3 rounded-full bg-[#A855F7] shadow-[0_0_12px_#A855F7]"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-[#A855F7]">Editorial Reviews</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white font-heading">
          Game & Hardware Reviews
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Rigorous, definitive reviews and technical score breakdowns written by our editorial team.
        </p>
      </div>

      <div class="text-xs font-mono text-slate-400 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-lg">
        {reviewArticles.length} Reviews Published
      </div>
    </div>

    <!-- Article Grid -->
    <ArticleGrid articles={reviewArticles} title="Latest Editorial Reviews" />
  </main>

  <Footer />
</Layout>
