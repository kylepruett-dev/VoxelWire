---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Terms of Service — VoxelWire" 
  description="VoxelWire Terms of Service governing user access, content rights, and acceptable use."
>
  <Header />

  <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <header class="mb-10 pb-6 border-b border-slate-800">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-950/70 text-[#C084FC] border border-[#A855F7]/40 text-xs font-mono font-semibold uppercase tracking-widest mb-3">
        Legal Terms
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white font-heading">
        Terms of Service
      </h1>
      <p class="text-slate-400 text-sm mt-2 font-mono">Last Updated: August 19, 2026</p>
    </header>

    <article class="prose prose-invert prose-purple max-w-none space-y-8 text-slate-300 text-sm sm:text-base leading-relaxed">
      <section class="space-y-3 bg-slate-900/40 p-6 rounded-2xl border border-slate-800">
        <h2 class="text-xl font-bold text-white font-heading">1. Acceptance of Terms</h2>
        <p>
          By accessing or using VoxelWire Media Network ("VoxelWire", "the Website"), you agree to be bound by these Terms of Service. If you do not agree to these terms, please discontinue use of the Website.
        </p>
      </section>

      <section class="space-y-3 bg-slate-900/40 p-6 rounded-2xl border border-slate-800">
        <h2 class="text-xl font-bold text-white font-heading">2. Intellectual Property & Content Rights</h2>
        <p>
          All articles, editorial reviews, graphics, logos, and custom media published on VoxelWire are the exclusive property of VoxelWire Media Network Inc. or its content licensors. You may quote brief snippets of our content provided you credit VoxelWire and include a direct link back to the original article.
        </p>
      </section>

      <section class="space-y-3 bg-slate-900/40 p-6 rounded-2xl border border-slate-800">
        <h2 class="text-xl font-bold text-white font-heading">3. Acceptable Use Policy</h2>
        <p>
          You agree not to disrupt the Website, scrape content using unauthorized automated tools, attempt to bypass access controls, or transmit malicious code. We reserve the right to block IP addresses violating network integrity.
        </p>
      </section>

      <section class="space-y-3 bg-slate-900/40 p-6 rounded-2xl border border-slate-800">
        <h2 class="text-xl font-bold text-white font-heading">4. Disclaimer & Limitation of Liability</h2>
        <p>
          Content on VoxelWire is provided for informational and entertainment purposes "as is." While we strive for absolute accuracy in hardware specifications and game coverage, VoxelWire is not liable for temporary service interruptions or external third-party links.
        </p>
      </section>

      <section class="space-y-3 bg-slate-900/40 p-6 rounded-2xl border border-slate-800">
        <h2 class="text-xl font-bold text-white font-heading">5. Governing Law</h2>
        <p>
          These Terms of Service are governed by and construed in accordance with applicable state and federal laws.
        </p>
      </section>
    </article>
  </main>

  <Footer />
</Layout>
