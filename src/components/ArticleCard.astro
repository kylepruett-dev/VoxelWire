---
import type { Article } from '../data/articles';

interface Props {
  article: Article;
}

const { article } = Astro.props;

const categoryColors: Record<string, string> = {
  News: 'bg-purple-950/70 text-purple-300 border-[#A855F7]/50 shadow-[0_0_10px_rgba(168,85,247,0.25)]',
  Reviews: 'bg-purple-900/60 text-[#D8B4FE] border-[#A855F7]/60 shadow-[0_0_12px_rgba(168,85,247,0.3)]',
  Guides: 'bg-purple-950/80 text-[#C084FC] border-[#A855F7]/50 shadow-[0_0_10px_rgba(168,85,247,0.25)]',
  'Patch Notes': 'bg-purple-950/70 text-purple-200 border-[#A855F7]/50 shadow-[0_0_10px_rgba(168,85,247,0.25)]',
  Hardware: 'bg-purple-950/70 text-[#C084FC] border-[#A855F7]/50 shadow-[0_0_10px_rgba(168,85,247,0.25)]',
};
---

<article class="group relative flex flex-col bg-slate-900/60 rounded-xl overflow-hidden border border-slate-800/90 border-t-2 border-t-[#A855F7] hover:border-t-[#C084FC] hover:border-slate-700 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_12px_30px_rgba(168,85,247,0.2)]">
  
  <!-- Thumbnail Image -->
  <div class="relative h-48 w-full overflow-hidden bg-slate-950">
    <img
      src={article.imageUrl}
      alt={article.title}
      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500 ease-out"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

    <!-- Category Tag -->
    <div class="absolute top-3 left-3 flex items-center gap-2">
      <span class={`text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border backdrop-blur-md ${categoryColors[article.category] || categoryColors.Hardware}`}>
        {article.category}
      </span>
    </div>

    <!-- Review Score Badge if applicable -->
    {article.score && (
      <div class="absolute top-3 right-3 bg-[#A855F7] text-white text-xs font-black px-2.5 py-1 rounded-md shadow-[0_0_12px_#A855F7] flex items-center gap-1 font-mono">
        <svg class="w-3 h-3 text-yellow-300 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        {article.score}
      </div>
    )}
  </div>

  <!-- Content Section -->
  <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-[11px] text-slate-400 font-mono">
        <span>{article.publishedAt}</span>
        <span>•</span>
        <span>{article.readTime}</span>
      </div>

      <h3 class="text-lg font-bold text-white group-hover:text-[#A855F7] transition-colors leading-snug font-heading">
        <a href={`/article/${article.slug}`}>
          {article.title}
        </a>
      </h3>

      <p class="text-slate-300 text-xs leading-relaxed line-clamp-2">
        {article.excerpt}
      </p>
    </div>

    <!-- Tags & Author Footer -->
    <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between">
      <div class="flex items-center gap-2">
        {article.author.avatar ? (
          <img
            src={article.author.avatar}
            alt={article.author.name}
            class="w-6 h-6 rounded-full object-cover ring-1 ring-slate-700"
          />
        ) : (
          <div class="w-6 h-6 rounded-full bg-slate-800 text-[10px] font-bold text-slate-300 flex items-center justify-center">
            {article.author.name.charAt(0)}
          </div>
        )}
        <span class="text-xs font-medium text-slate-300">{article.author.name}</span>
      </div>

      <div class="flex items-center gap-1">
        {article.tags.slice(0, 1).map((tag) => (
          <span class="text-[10px] text-slate-400 font-mono bg-slate-800/50 px-2 py-0.5 rounded">
            #{tag}
          </span>
        ))}
      </div>
    </div>

  </div>

</article>
