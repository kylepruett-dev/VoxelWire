---
---

<footer class="mt-auto bg-[#060910] border-t border-slate-800/80 pt-12 pb-8 text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-800/60">
      
      <!-- Column 1: Brand -->
      <div class="space-y-4 md:col-span-1">
        <a href="/" class="flex items-center gap-2.5 text-xl font-bold tracking-tight text-white font-heading">
          <img 
            src="/favicon.svg" 
            alt="VoxelWire Logo" 
            class="w-7 h-7 rounded-lg shadow-[0_0_10px_rgba(168,85,247,0.4)]"
          />
          Voxel<span class="text-[#A855F7]">Wire</span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          The premiere digital wire for next-gen gaming news, hardware architecture breakdowns, in-depth benchmarks, and live esports updates.
        </p>
      </div>

      <!-- Column 2: Navigation -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-heading">Categories</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/news" class="hover:text-[#A855F7] transition-colors">News</a></li>
          <li><a href="/reviews" class="hover:text-[#A855F7] transition-colors">Reviews</a></li>
          <li>
            <a href="/rss.xml" class="hover:text-[#A855F7] transition-colors flex items-center gap-1.5">
              <svg class="w-3 h-3 text-[#A855F7]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
              </svg>
              <span>RSS Feed</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-heading">VoxelWire Network</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/about" class="hover:text-[#A855F7] transition-colors">About Us</a></li>
          <li><a href="/editorial-guidelines" class="hover:text-[#A855F7] transition-colors">Editorial Guidelines</a></li>
          <li><a href="/contact-us" class="hover:text-[#A855F7] transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-heading">Stay Wired</h4>
        <p class="text-xs text-slate-400">Get the daily briefing delivered directly to your inbox every morning.</p>
        <form id="footer-subscribe-form" class="flex gap-2">
          <input
            id="footer-email-input"
            type="email"
            required
            placeholder="Enter your email"
            class="bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-[#A855F7] flex-1"
          />
          <button
            id="footer-subscribe-btn"
            type="submit"
            class="bg-[#A855F7] hover:bg-[#9333EA] text-white text-xs font-bold px-3 py-2 rounded-lg transition-colors shadow-[0_0_10px_rgba(168,85,247,0.3)] disabled:opacity-50 disabled:cursor-not-allowed shrink-0"
          >
            Join
          </button>
        </form>
        <div id="footer-subscribe-message" class="hidden text-xs mt-2"></div>
      </div>

    </div>

    <!-- Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>
        © {new Date().getFullYear()} VoxelWire Media Network Inc. All rights reserved.
      </div>
      <div class="flex gap-4">
        <a href="/contact-us" class="hover:text-slate-400">Contact Us</a>
        <a href="/privacy" class="hover:text-slate-400">Privacy Policy</a>
        <a href="/terms" class="hover:text-slate-400">Terms of Service</a>
        <a href="/cookies" class="hover:text-slate-400">Cookie Settings</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const footerForm = document.getElementById('footer-subscribe-form') as HTMLFormElement | null;
  const footerEmailInput = document.getElementById('footer-email-input') as HTMLInputElement | null;
  const footerBtn = document.getElementById('footer-subscribe-btn') as HTMLButtonElement | null;
  const footerMsg = document.getElementById('footer-subscribe-message') as HTMLDivElement | null;

  footerForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = footerEmailInput?.value?.trim();
    if (!email || !footerBtn || !footerMsg) return;

    footerBtn.disabled = true;
    const origText = footerBtn.textContent;
    footerBtn.textContent = '...';
    footerMsg.classList.add('hidden');
    footerMsg.className = 'hidden text-xs mt-2';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();

      if (res.ok) {
        footerMsg.textContent = 'Thanks for joining VoxelWire!';
        footerMsg.className = 'text-xs mt-2 p-2 rounded-lg bg-purple-950/80 text-[#C084FC] border border-[#A855F7]/30 font-semibold';
        footerMsg.classList.remove('hidden');
        footerBtn.textContent = 'Joined!';
        footerBtn.disabled = true;
        if (footerEmailInput) footerEmailInput.disabled = true;
      } else {
        footerMsg.textContent = data.error || 'Failed to subscribe. Please try again.';
        footerMsg.className = 'text-xs mt-2 p-2 rounded-lg bg-red-950/80 text-red-300 border border-red-800/40 font-medium';
        footerMsg.classList.remove('hidden');
        footerBtn.disabled = false;
        footerBtn.textContent = origText;
      }
    } catch (err) {
      footerMsg.textContent = 'Network error. Please check your connection.';
      footerMsg.className = 'text-xs mt-2 p-2 rounded-lg bg-red-950/80 text-red-300 border border-red-800/40 font-medium';
      footerMsg.classList.remove('hidden');
      footerBtn.disabled = false;
      footerBtn.textContent = origText;
    }
  });
</script>

