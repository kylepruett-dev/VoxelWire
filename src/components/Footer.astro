---
---

<footer class="mt-auto bg-[#060910] border-t border-slate-800/80 pt-12 pb-8 text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-800/60">
      
      <!-- Column 1: Brand -->
      <div class="space-y-4 md:col-span-1">
        <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight text-white font-heading">
          <span class="inline-flex rounded-full h-3 w-3 bg-[#A855F7] shadow-[0_0_10px_#A855F7]"></span>
          Voxel<span class="text-[#A855F7]">Wire</span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          The premiere digital wire for next-gen gaming news, hardware architecture breakdowns, in-depth benchmarks, and live esports updates.
        </p>
      </div>

      <!-- Column 2: Navigation -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-heading">Categories</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/news" class="hover:text-[#A855F7] transition-colors">News</a></li>
          <li><a href="/reviews" class="hover:text-[#A855F7] transition-colors">Reviews</a></li>
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-heading">VoxelWire Network</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/about" class="hover:text-[#A855F7] transition-colors">About Us</a></li>
          <li><a href="/editorial-guidelines" class="hover:text-[#A855F7] transition-colors">Editorial Guidelines</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-heading">Stay Wired</h4>
        <p class="text-xs text-slate-400">Get the daily briefing delivered directly to your inbox every morning.</p>
        <div class="flex gap-2">
          <input
            type="email"
            placeholder="Enter your email"
            class="bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-[#A855F7] flex-1"
          />
          <button class="bg-[#A855F7] hover:bg-[#9333EA] text-white text-xs font-bold px-3 py-2 rounded-lg transition-colors shadow-[0_0_10px_rgba(168,85,247,0.3)]">
            Join
          </button>
        </div>
      </div>

    </div>

    <!-- Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>
        © {new Date().getFullYear()} VoxelWire Media Network Inc. All rights reserved.
      </div>
      <div class="flex gap-4">
        <a href="/privacy" class="hover:text-slate-400">Privacy Policy</a>
        <a href="/terms" class="hover:text-slate-400">Terms of Service</a>
        <a href="/cookies" class="hover:text-slate-400">Cookie Settings</a>
      </div>
    </div>
  </div>
</footer>
