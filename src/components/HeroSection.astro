---
import type { Article } from '../data/articles';

interface Props {
  featured: Article;
  latest: Article[];
}

const { featured, latest } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    
    <!-- Left Column: Featured Post (7 or 8 columns wide) -->
    <div class="lg:col-span-7 xl:col-span-8 flex flex-col">
      <article class="group relative flex-1 flex flex-col bg-slate-900/50 rounded-2xl overflow-hidden border border-slate-800 hover:border-[#A855F7]/50 transition-all duration-300 shadow-xl hover:shadow-[0_0_30px_rgba(168,85,247,0.15)] cursor-pointer">
        
        <!-- Large Thumbnail Container -->
        <div class="relative h-72 sm:h-96 w-full overflow-hidden bg-slate-950">
          <img
            src={featured.imageUrl}
            alt={featured.title}
            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500 ease-out"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#090D16] via-[#090D16]/40 to-transparent"></div>
          
          <!-- Top Badges -->
          <div class="absolute top-4 left-4 flex items-center gap-2">
            <span class="bg-[#A855F7] text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-md shadow-[0_0_10px_rgba(168,85,247,0.5)]">
              FEATURED
            </span>
            <span class="bg-slate-950/80 backdrop-blur-sm text-purple-300 text-xs font-medium px-3 py-1 rounded-md border border-[#A855F7]/30">
              {featured.category}
            </span>
          </div>

          <!-- Bottom Time Indicator on Image -->
          <div class="absolute bottom-4 right-4 text-xs font-semibold text-slate-300 bg-slate-950/80 backdrop-blur-sm px-2.5 py-1 rounded-full border border-slate-800 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#A855F7] animate-pulse"></span>
            {featured.publishedAt}
          </div>
        </div>

        <!-- Featured Post Details -->
        <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight font-heading group-hover:text-[#A855F7] transition-colors duration-200">
              <a href={`/article/${featured.slug}`} class="after:absolute after:inset-0">
                {featured.title}
              </a>
            </h1>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed line-clamp-3">
              {featured.excerpt}
            </p>
          </div>

          <!-- Author & Action Footer -->
          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <div class="flex items-center gap-3">
              {featured.author.avatar ? (
                <img
                  src={featured.author.avatar}
                  alt={featured.author.name}
                  class="w-9 h-9 rounded-full object-cover ring-2 ring-[#A855F7]/40"
                />
              ) : (
                <div class="w-9 h-9 rounded-full bg-purple-900/40 border border-[#A855F7]/40 flex items-center justify-center text-xs font-bold text-[#A855F7]">
                  VW
                </div>
              )}
              <div>
                <div class="text-sm font-semibold text-white">{featured.author.name}</div>
                <div class="text-xs text-slate-400">{featured.author.role} • {featured.readTime}</div>
              </div>
            </div>

            <span class="inline-flex items-center gap-1.5 text-xs font-bold tracking-wider uppercase text-[#A855F7] group-hover:text-purple-300 transition-colors">
              Read Story
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </span>
          </div>

        </div>

      </article>
    </div>

    <!-- Right Column: Stacked List of Latest Updates (5 or 4 columns wide) -->
    <div class="lg:col-span-5 xl:col-span-4 flex flex-col justify-between">
      <div class="bg-slate-900/40 rounded-2xl border border-slate-800 p-6 flex-1 flex flex-col">
        
        <!-- Header -->
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-6 bg-[#A855F7] rounded-full shadow-[0_0_10px_#A855F7]"></span>
            <h2 class="text-lg font-bold text-white font-heading tracking-wide uppercase">Latest Updates</h2>
          </div>
          <span class="text-xs font-medium text-slate-400 uppercase tracking-widest">Live Wire</span>
        </div>

        <!-- Stacked Items List -->
        <div class="divide-y divide-slate-800/60 flex-1 flex flex-col justify-around">
          {latest.map((item, index) => (
            <article class="group relative py-3.5 first:pt-0 last:pb-0 transition-all duration-200 cursor-pointer">
              <div class="flex items-center gap-3">
                <!-- Thumbnail Image -->
                <div class="relative shrink-0 w-20 h-16 rounded-lg overflow-hidden bg-slate-950 border border-slate-800/80 group-hover:border-[#A855F7]/60 transition-all shadow-md">
                  <img
                    src={item.imageUrl}
                    alt={item.title}
                    class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-300 ease-out"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent"></div>
                </div>

                <!-- Content -->
                <div class="space-y-1 flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-purple-950/60 text-[#A855F7] border border-[#A855F7]/30">
                      {item.category}
                    </span>
                    <span class="text-[11px] text-slate-400 font-mono">{item.publishedAt}</span>
                  </div>
                  <h3 class="text-sm font-semibold text-slate-200 group-hover:text-[#A855F7] transition-colors leading-snug line-clamp-2">
                    <a href={`/article/${item.slug}`} class="after:absolute after:inset-0">
                      {item.title}
                    </a>
                  </h3>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- View All Link -->
        <div class="pt-4 mt-4 border-t border-slate-800 text-center">
          <a href="#latest" class="text-xs font-semibold text-slate-400 hover:text-[#A855F7] transition-colors flex items-center justify-center gap-1">
            <span>View All Stream Activity</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
