---
import { getArticlesData } from '../utils/articles';
import ArticleCard from './ArticleCard.astro';

interface Props {
  currentSlug: string;
  category: string;
  tags?: string[];
  title?: string;
}

const { currentSlug, category, tags = [], title = '' } = Astro.props;
const { all: allArticles } = await getArticlesData();

// Filter out the current article
const otherArticles = allArticles.filter(a => a.slug !== currentSlug && a.id !== currentSlug);

// Common stop words to exclude from title keyword matching
const stopWords = new Set(['the', 'and', 'for', 'with', 'that', 'this', 'from', 'have', 'what', 'game', 'full', 'look', 'best', 'part', 'will']);

// Extract key title terms (>3 letters)
const currentTitleWords = title
  .toLowerCase()
  .replace(/[^a-z0-9\s]/g, '')
  .split(/\s+/)
  .filter(w => w.length > 3 && !stopWords.has(w));

// Calculate relevance score based on category match, tag overlaps, and title keywords
const scoredArticles = otherArticles.map(article => {
  let score = 0;

  // Category match
  if (article.category === category) score += 5;

  // Review matching bonus: If currently reading a review, prioritize other reviews
  if (category === 'Reviews' && article.category === 'Reviews') score += 4;

  // Tag overlap match
  const currentTagsLower = tags.map(t => t.toLowerCase());
  const articleTagsLower = (article.tags || []).map(t => t.toLowerCase());
  const matchingTags = articleTagsLower.filter(t => currentTagsLower.includes(t));
  score += matchingTags.length * 3;

  // Title keyword overlap match
  const articleTitleLower = article.title.toLowerCase();
  const matchingTitleWords = currentTitleWords.filter(w => articleTitleLower.includes(w));
  score += matchingTitleWords.length * 2;

  return { article, score };
});

// Sort by score descending, then publication date descending
scoredArticles.sort((a, b) => {
  if (b.score !== a.score) return b.score - a.score;
  return (b.article.pubDateRaw?.getTime() || 0) - (a.article.pubDateRaw?.getTime() || 0);
});

// Take top 3 related articles
let related = scoredArticles.slice(0, 3).map(s => s.article);

// Fallback fill if fewer than 3 related articles found
if (related.length < 3) {
  const existingIds = new Set(related.map(a => a.id));
  const fallback = otherArticles
    .filter(a => !existingIds.has(a.id))
    .sort((a, b) => (b.pubDateRaw?.getTime() || 0) - (a.pubDateRaw?.getTime() || 0));

  related = [...related, ...fallback.slice(0, 3 - related.length)];
}

const sectionHeading = category === 'Reviews' ? 'RELATED REVIEWS & COVERAGE' : 'NEXT ON THE WIRE';
---

{related.length > 0 && (
  <section class="mt-14 pt-10 border-t border-slate-800 space-y-6">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-3 h-8 bg-[#A855F7] rounded-md shadow-[0_0_12px_#A855F7]"></span>
        <h3 class="text-2xl font-extrabold text-white font-heading tracking-tight">
          {sectionHeading}
        </h3>
      </div>
      <span class="text-xs font-mono uppercase tracking-widest text-[#A855F7] hidden sm:inline-block font-semibold">
        Automatically Curated Reads
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {related.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>
)}

