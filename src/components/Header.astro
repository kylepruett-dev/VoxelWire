---
import { getArticlesData } from '../utils/articles';

interface Props {
  activeCategory?: string;
}

const { activeCategory = 'All' } = Astro.props;
const { all: searchIndex } = await getArticlesData();

const navItems = [
  { name: 'News', href: '/news' },
  { name: 'Reviews', href: '/reviews' },
];
---

<header class="sticky top-0 z-50 bg-[#090D16]/85 backdrop-blur-md border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="group flex items-center gap-2.5 text-2xl font-bold tracking-tight text-white font-heading shrink-0">
        <img 
          src="/favicon.svg" 
          alt="VoxelWire Logo" 
          class="w-8 h-8 rounded-lg shadow-[0_0_12px_rgba(168,85,247,0.4)] group-hover:shadow-[0_0_20px_rgba(168,85,247,0.8)] group-hover:scale-105 transition-all duration-200"
        />
        <span class="transition-colors duration-200 group-hover:text-white">
          Voxel<span class="text-[#A855F7] group-hover:drop-shadow-[0_0_10px_rgba(168,85,247,0.8)]">Wire</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navItems.map((item) => {
          const isActive = activeCategory.toLowerCase() === item.name.toLowerCase();
          return (
            <a
              href={item.href}
              class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 relative ${
                isActive 
                  ? 'text-[#A855F7] bg-[#A855F7]/10 font-semibold' 
                  : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
              }`}
            >
              {item.name}
              {isActive && (
                <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-4 h-0.5 bg-[#A855F7] rounded-full shadow-[0_0_8px_#A855F7]"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right Search & Actions -->
      <div class="hidden sm:flex items-center gap-4 relative">
        <form id="desktop-search-form" class="relative" action="/search" method="GET">
          <input
            id="desktop-search-input"
            name="q"
            type="text"
            autocomplete="off"
            placeholder="Search news, reviews..."
            class="w-48 lg:w-64 bg-slate-900/90 text-slate-200 placeholder-slate-400 text-sm rounded-full py-2 pl-9 pr-4 border border-slate-800 focus:outline-none focus:border-[#A855F7] focus:ring-1 focus:ring-[#A855F7] transition-all duration-200 shadow-inner"
          />
          <svg
            class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>

          <!-- Desktop Search Popup Dropdown -->
          <div
            id="desktop-search-dropdown"
            class="hidden absolute right-0 top-12 w-80 lg:w-96 bg-slate-950/95 backdrop-blur-xl border border-slate-800 rounded-2xl p-3 shadow-2xl z-50 divide-y divide-slate-800/60 max-h-96 overflow-y-auto"
          >
          </div>
        </form>

        <button 
          id="open-subscribe-modal"
          aria-label="Subscribe to Newsletter"
          class="bg-[#A855F7] hover:bg-[#9333EA] text-white text-xs uppercase tracking-wider font-bold py-2 px-4 rounded-full transition-all duration-200 shadow-[0_0_15px_rgba(168,85,247,0.3)] hover:shadow-[0_0_20px_rgba(168,85,247,0.6)] hover:scale-105 active:scale-95 shrink-0"
        >
          Subscribe
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center md:hidden gap-2">
        <button
          id="mobile-menu-btn"
          aria-label="Open Navigation Menu"
          class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800 focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-[#090D16]/95 px-4 pt-2 pb-6 space-y-3">
    <div class="pt-2 relative">
      <form id="mobile-search-form" action="/search" method="GET">
        <input
          id="mobile-search-input"
          name="q"
          type="text"
          autocomplete="off"
          placeholder="Search news, reviews..."
          class="w-full bg-slate-900 text-slate-200 placeholder-slate-400 text-sm rounded-lg py-2.5 pl-9 pr-4 border border-slate-800 focus:outline-none focus:border-[#A855F7]"
        />
        <svg
          class="w-4 h-4 text-slate-400 absolute left-3 top-6 -translate-y-1/2 pointer-events-none"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>

        <div
          id="mobile-search-dropdown"
          class="hidden mt-2 bg-slate-950/95 border border-slate-800 rounded-xl p-3 divide-y divide-slate-800/60 max-h-80 overflow-y-auto"
        >
        </div>
      </form>
    </div>
    <div class="flex flex-col space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-slate-300 hover:text-[#A855F7] hover:bg-slate-800/60 px-3 py-2 rounded-md text-base font-medium"
        >
          {item.name}
        </a>
      ))}
      <button
        id="mobile-open-subscribe-modal"
        class="w-full text-left text-[#A855F7] bg-[#A855F7]/10 hover:bg-[#A855F7]/20 px-3 py-2 rounded-md text-base font-semibold transition-colors mt-2"
      >
        Subscribe to Newsletter
      </button>
    </div>
  </div>
</header>

<!-- Subscribe Modal Overlay -->
<div id="subscribe-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm transition-opacity">
  <div class="relative w-full max-w-md bg-[#0D111D] border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl overflow-hidden">
    <!-- Purple Ambient Glow -->
    <div class="absolute -top-12 -right-12 w-32 h-32 bg-[#A855F7]/20 rounded-full blur-2xl pointer-events-none"></div>

    <!-- Close button -->
    <button
      id="close-subscribe-modal"
      type="button"
      class="absolute top-4 right-4 text-slate-400 hover:text-white p-1.5 rounded-lg transition-colors focus:outline-none hover:bg-slate-800/60"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Modal Content -->
    <div class="space-y-4">
      <div class="flex items-center gap-2.5 text-xl font-bold tracking-tight text-white font-heading">
        <span class="inline-flex rounded-full h-3.5 w-3.5 bg-[#A855F7] shadow-[0_0_12px_#A855F7]"></span>
        <span>Voxel<span class="text-[#A855F7]">Wire</span> Briefing</span>
      </div>

      <p class="text-xs text-slate-300 leading-relaxed">
        Join our network to get daily next-gen gaming news, hardware breakdowns, in-depth benchmarks, and patch notes delivered to your inbox.
      </p>

      <form id="navbar-subscribe-form" class="space-y-3 pt-2">
        <div>
          <label for="navbar-email-input" class="sr-only">Email address</label>
          <input
            id="navbar-email-input"
            type="email"
            required
            placeholder="Enter your email address..."
            class="w-full bg-slate-900/90 text-slate-200 placeholder-slate-500 text-sm rounded-xl px-4 py-3 border border-slate-800 focus:outline-none focus:border-[#A855F7] focus:ring-1 focus:ring-[#A855F7] transition-all"
          />
        </div>

        <button
          id="navbar-subscribe-btn"
          type="submit"
          class="w-full bg-[#A855F7] hover:bg-[#9333EA] text-white font-bold text-sm py-3 px-4 rounded-xl transition-all duration-200 shadow-[0_0_15px_rgba(168,85,247,0.3)] hover:shadow-[0_0_20px_rgba(168,85,247,0.6)] disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Subscribe
        </button>
      </form>

      <!-- Success / Error Message Container -->
      <div id="navbar-subscribe-message" class="hidden text-xs text-center py-1"></div>
    </div>
  </div>
</div>

<!-- Pass search index to client via JSON script element -->
<script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />

<script>
  import Fuse from 'fuse.js';

  // Mobile menu handling
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Client-side search setup with Fuse.js
  const searchDataEl = document.getElementById('search-data');
  const articles = searchDataEl?.textContent ? JSON.parse(searchDataEl.textContent) : [];

  const fuse = new Fuse(articles, {
    keys: [
      { name: 'title', weight: 0.4 },
      { name: 'excerpt', weight: 0.2 },
      { name: 'category', weight: 0.2 },
      { name: 'tags', weight: 0.15 },
      { name: 'slug', weight: 0.05 }
    ],
    threshold: 0.4,
    ignoreLocation: true,
    minMatchCharLength: 1
  });

  const categoryColors: Record<string, string> = {
    News: 'bg-purple-950/80 text-purple-300 border-[#A855F7]/40',
    Reviews: 'bg-purple-900/60 text-[#D8B4FE] border-[#A855F7]/50',
    Guides: 'bg-purple-950/80 text-[#C084FC] border-[#A855F7]/40',
    'Patch Notes': 'bg-purple-950/80 text-purple-200 border-[#A855F7]/40',
    Hardware: 'bg-purple-950/80 text-[#C084FC] border-[#A855F7]/40',
  };

  function setupSearch(inputId: string, dropdownId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    const dropdown = document.getElementById(dropdownId) as HTMLElement | null;
    if (!input || !dropdown) return;

    function renderResults(query: string) {
      const trimmed = query.trim();
      if (!trimmed) {
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        return;
      }

      const results = fuse.search(trimmed).map(res => res.item);

      if (results.length === 0) {
        dropdown.innerHTML = `
          <div class="p-4 text-xs text-slate-400 font-mono text-center space-y-1">
            <p class="text-slate-300 font-medium">No results found for "${query}"</p>
            <p class="text-[11px] text-slate-500">Try searching for news, reviews, or tags like #GTA6 or #STALKER2</p>
          </div>
        `;
      } else {
        dropdown.innerHTML = results.slice(0, 6).map(item => `
          <a href="/article/${item.slug}" class="flex items-center gap-3 p-2.5 hover:bg-slate-900/90 rounded-xl transition-all duration-200 group border border-transparent hover:border-[#A855F7]/30">
            <img src="${item.imageUrl}" alt="${item.title}" class="w-12 h-12 rounded-lg object-cover border border-slate-800 shrink-0 group-hover:border-[#A855F7]/50 transition-colors" />
            <div class="min-w-0 flex-1 space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded border backdrop-blur-md ${categoryColors[item.category] || 'bg-purple-950 text-[#C084FC] border-[#A855F7]/30'}">${item.category}</span>
                <span class="text-[10px] text-slate-400 font-mono flex items-center gap-1">
                  <span>⏱ ${item.readTime || '5 min read'}</span>
                </span>
              </div>
              <div class="text-xs font-semibold text-white group-hover:text-[#A855F7] transition-colors truncate">${item.title}</div>
            </div>
          </a>
        `).join('');
      }

      dropdown.classList.remove('hidden');
    }

    input.addEventListener('input', (e) => {
      renderResults((e.target as HTMLInputElement).value);
    });

    input.addEventListener('focus', (e) => {
      if ((e.target as HTMLInputElement).value.trim()) {
        renderResults((e.target as HTMLInputElement).value);
      }
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdown.classList.add('hidden');
      }
    });
  }

  setupSearch('desktop-search-input', 'desktop-search-dropdown');
  setupSearch('mobile-search-input', 'mobile-search-dropdown');

  // Subscribe Modal & Form handling
  const modal = document.getElementById('subscribe-modal');
  const openModalBtn = document.getElementById('open-subscribe-modal');
  const mobileOpenModalBtn = document.getElementById('mobile-open-subscribe-modal');
  const closeModalBtn = document.getElementById('close-subscribe-modal');

  function openSubscribeModal() {
    modal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    const emailInput = document.getElementById('navbar-email-input') as HTMLInputElement | null;
    if (emailInput) emailInput.focus();
  }

  function closeSubscribeModal() {
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  openModalBtn?.addEventListener('click', openSubscribeModal);
  mobileOpenModalBtn?.addEventListener('click', () => {
    menu?.classList.add('hidden');
    openSubscribeModal();
  });

  closeModalBtn?.addEventListener('click', closeSubscribeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeSubscribeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeSubscribeModal();
    }
  });

  const navForm = document.getElementById('navbar-subscribe-form');
  const navEmailInput = document.getElementById('navbar-email-input') as HTMLInputElement | null;
  const navBtn = document.getElementById('navbar-subscribe-btn') as HTMLButtonElement | null;
  const navMsg = document.getElementById('navbar-subscribe-message');

  navForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = navEmailInput?.value?.trim();
    if (!email || !navBtn || !navMsg) return;

    navBtn.disabled = true;
    const origText = navBtn.textContent;
    navBtn.textContent = 'Subscribing...';
    navMsg.classList.add('hidden');
    navMsg.className = 'hidden text-xs text-center py-1';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();

      if (res.ok) {
        navMsg.textContent = 'Thanks for joining VoxelWire!';
        navMsg.className = 'text-xs text-center py-2.5 px-3 rounded-lg bg-purple-950/80 text-[#C084FC] border border-[#A855F7]/30 font-semibold mt-2';
        navMsg.classList.remove('hidden');
        navBtn.textContent = 'Subscribed!';
        navBtn.disabled = true;
        if (navEmailInput) navEmailInput.disabled = true;
      } else {
        navMsg.textContent = data.error || 'Failed to subscribe. Please try again.';
        navMsg.className = 'text-xs text-center py-2.5 px-3 rounded-lg bg-red-950/80 text-red-300 border border-red-800/40 font-medium mt-2';
        navMsg.classList.remove('hidden');
        navBtn.disabled = false;
        navBtn.textContent = origText;
      }
    } catch (err) {
      navMsg.textContent = 'Network error. Please check your connection.';
      navMsg.className = 'text-xs text-center py-2.5 px-3 rounded-lg bg-red-950/80 text-red-300 border border-red-800/40 font-medium mt-2';
      navMsg.classList.remove('hidden');
      navBtn.disabled = false;
      navBtn.textContent = origText;
    }
  });
</script>

