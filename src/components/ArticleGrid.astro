---
import ArticleCard from './ArticleCard.astro';
import type { Article } from '../data/articles';

interface Props {
  articles: Article[];
  title?: string;
}

const { articles, title = "Latest Wire Briefs" } = Astro.props;

// Dynamically extract unique categories from provided articles
const uniqueCategories = Array.from(new Set(articles.map(a => a.category)));
const categories = ['All', ...uniqueCategories];
---

<section id="latest" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
  
  <!-- Section Header with Filters -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10 pb-4 border-b border-slate-800">
    <div class="flex items-center gap-3">
      <span class="w-3 h-8 bg-[#A855F7] rounded-md shadow-[0_0_12px_#A855F7]"></span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-heading tracking-tight">
        {title}
      </h2>
    </div>

    <!-- Category Pills Filter -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-2 md:pb-0 no-scrollbar">
      {categories.map((category, idx) => (
        <button
          data-filter={category}
          class={`filter-btn px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all duration-200 whitespace-nowrap border ${
            idx === 0
              ? 'bg-[#A855F7] text-white shadow-[0_0_15px_rgba(168,85,247,0.4)] border-[#A855F7]'
              : 'bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 border-slate-800'
          }`}
        >
          {category}
        </button>
      ))}
    </div>
  </div>

  <!-- Responsive 3-Column Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
    {articles.map((article) => (
      <div
        class="article-item"
        data-category={article.category}
        data-title={article.title}
        data-excerpt={article.excerpt}
        data-tags={(article.tags || []).join(' ')}
      >
        <ArticleCard article={article} />
      </div>
    ))}

    <div id="no-articles-message" class="hidden col-span-full text-center py-16 text-slate-400 font-mono text-sm bg-slate-900/40 rounded-2xl border border-slate-800/80">
      <p class="text-slate-300 font-medium mb-1">No articles found in this category</p>
      <p class="text-xs text-slate-500">Select another filter pill or view 'All' articles.</p>
    </div>
  </div>

  <!-- Load More Action -->
  <div class="mt-14 text-center">
    <button class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-800 text-slate-200 hover:text-[#A855F7] text-xs font-bold uppercase tracking-widest py-3.5 px-8 rounded-full border border-slate-800 hover:border-[#A855F7]/50 transition-all duration-200 shadow-lg hover:shadow-[0_0_20px_rgba(168,85,247,0.2)]">
      <span>Load More Articles</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
  </div>

</section>

<script>
  function setupCategoryFilters() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.article-item');
    const noArticlesMsg = document.getElementById('no-articles-message');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-filter');

        // Update button active states
        filterBtns.forEach(b => {
          b.classList.remove('bg-[#A855F7]', 'text-white', 'shadow-[0_0_15px_rgba(168,85,247,0.4)]', 'border-[#A855F7]');
          b.classList.add('bg-slate-900', 'text-slate-400', 'hover:text-white', 'hover:bg-slate-800', 'border-slate-800');
        });

        btn.classList.remove('bg-slate-900', 'text-slate-400', 'hover:text-white', 'hover:bg-slate-800', 'border-slate-800');
        btn.classList.add('bg-[#A855F7]', 'text-white', 'shadow-[0_0_15px_rgba(168,85,247,0.4)]', 'border-[#A855F7]');

        // Filter article grid items instantly
        let visibleCount = 0;
        items.forEach(item => {
          const itemCategory = item.getAttribute('data-category');
          if (category === 'All' || itemCategory === category) {
            item.style.display = 'block';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (noArticlesMsg) {
          if (visibleCount === 0) {
            noArticlesMsg.classList.remove('hidden');
          } else {
            noArticlesMsg.classList.add('hidden');
          }
        }
      });
    });
  }

  setupCategoryFilters();
</script>
